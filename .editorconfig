root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot uses tabs for GDScript; the editor enforces this — pin it for external tools.
[*.gd]
indent_style = tab

# Godot-authored text resources are tab-indented.
[*.{tscn,tres,godot,import}]
indent_style = tab

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
